{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "api-ecosystem-for-laravel/dingo-api": "^4.8",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "laravel/framework": "^12.0",
        "laravel/helpers": "^1.7",
        "laravel/tinker": "^2.10.1",
        "laravel/ui": "^4.6",
        "maatwebsite/excel": "^3.1.70",
        "tymon/jwt-auth": "2.3.1",
        "yajra/laravel-datatables-oracle": "^12.7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "filp/whoops": "^2.16",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Hesto\\MultiAuth\\": "app/Legacy/Hesto/MultiAuth/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
